<?xml version="1.0"?>
<ruleset name="IndexPilot">
	<description>Стандарты кода плагина: WordPress-Extra, имена файлов по PSR-4.</description>

	<file>indexpilot.php</file>
	<file>uninstall.php</file>
	<file>src</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress-Extra">
		<!-- Классы лежат по PSR-4: src/Variables/Renderer.php, а не class-renderer.php. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="indexpilot"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="indexpilot"/>
				<element value="IndexPilot"/>
			</property>
		</properties>
	</rule>
</ruleset>
