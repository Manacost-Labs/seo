{
	"name": "indexpilot/indexpilot",
	"description": "SEO-плагин для Hearthstone-сайтов: мета-теги, предпросмотр сниппета, анализ, рубрики, колоды.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5 || ^11.0",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"IndexPilot\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"IndexPilot\\Tests\\": "tests/php/",
			"IndexPilot\\Tools\\": "../tools/lib/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	}
}
